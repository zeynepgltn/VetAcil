<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Test Konumu Seç"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#E91E63"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- Açıklama -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test için farklı şehirleri deneyebilir veya manuel koordinat girebilirsiniz."
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Gerçek Konum Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUseRealLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Gerçek Konumumu Kullan"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:icon="@android:drawable/ic_menu_mylocation"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Hazır Konumlar Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hazır Test Konumları"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Konum Listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDebugLocations"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scrollbars="vertical" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Manuel Koordinat Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manuel Koordinat Gir"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:paddingBottom="8dp" />

    <!-- Enlem (Latitude) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enlem (Latitude)"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLatitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal|numberSigned" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Boylam (Longitude) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Boylam (Longitude)"
        android:layout_marginTop="8dp"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLongitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal|numberSigned" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Manuel Konum Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetCustomLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Bu Konumu Kullan"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />

</LinearLayout>